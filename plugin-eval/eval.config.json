{
  "version": "1.0.0",
  "plugin_path": "../plugin",
  "test_suites": [
    "suites/basic.json",
    "suites/threat-modeling.json",
    "suites/security-assessment.json"
  ],
  "sandbox": {
    "timeout": 30000,
    "max_retries": 2,
    "environment": "test"
  },
  "reporting": {
    "format": "json",
    "output_dir": "reports",
    "generate_html": true,
    "fail_threshold": 0.8
  },
  "ci": {
    "enabled": true,
    "fail_on_warning": false,
    "publish_results": true
  }
}
